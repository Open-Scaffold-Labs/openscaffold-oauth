# openscaffold-oauth environment configuration
# Copy to .env and fill in real values.

# Server
PORT=4000
NODE_ENV=development
ISSUER=http://localhost:4000

# Database (shared with the Open Scaffold ecosystem)
DATABASE_URL=postgresql://localhost:5432/openfirehouse

# JWKS — generated on first start; persist for production via PG_JWKS_KEY
# For dev, leave unset and a fresh keypair will be generated each restart.

# Cookie secret (for the OIDC session cookie)
COOKIE_SECRET=dev-openscaffold-oauth-cookie-secret-change-me-2026

# OAuth client for openlawfirm-mcp
OLF_MCP_CLIENT_ID=openlawfirm-mcp-claude-connector
OLF_MCP_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback,http://localhost:8765/callback

# Logging
LOG_LEVEL=info
